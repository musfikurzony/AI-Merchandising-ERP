# Copy this file to .env.local (git-ignored) and fill in the values from
# your Supabase project's Settings -> API page.
#
# The anon key is safe to expose in the browser -- it's designed for that,
# and Row Level Security (supabase/02_rls_policies.sql onward) is what
# actually enforces who can do what. The service_role key is never used
# here -- it belongs only inside the admin-manage-user Edge Function.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
